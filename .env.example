# ============================================================
# GOC Studio Management System v2.0 — Environment Variables
# ============================================================

# Backend Server
PORT=4000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=goc_studio
DB_USER=root
DB_PASS=your_password

# JWT Authentication
JWT_SECRET=your_super_secret_key_min_32_chars_change_in_production
JWT_EXPIRES_IN=7d

# MSG91 WhatsApp Integration
MSG91_AUTH_KEY=your_msg91_key
MSG91_WHATSAPP_SENDER=your_sender_id
MSG91_TEMPLATE_IDS={}

# File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Frontend (used by Vite)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Studio Configuration
STUDIO_LAT=22.3119
STUDIO_LNG=73.1723
ATTENDANCE_RADIUS_METERS=50
STUDIO_GSTIN=24XXXXX1234X1ZX
STUDIO_NAME=God of Ceramic
STUDIO_ADDRESS=Near Akshar Chowk, Alkapuri, Vadodara, Gujarat 390007
STUDIO_PHONE=+919999999999

# ── Facebook / Instagram Lead Ads ────────────────────────────
META_APP_ID=your_facebook_app_id
META_APP_SECRET=your_facebook_app_secret
META_PAGE_ACCESS_TOKEN=your_page_long_lived_access_token
META_VERIFY_TOKEN=GOC_META_WEBHOOK_2026_SECURE_TOKEN

# ── WhatsApp Inbound (MSG91) ──────────────────────────────────
MSG91_WEBHOOK_SECRET=GOC_WA_WEBHOOK_2026_SECURE_TOKEN

